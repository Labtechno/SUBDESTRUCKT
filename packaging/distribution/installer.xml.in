<?xml version="1.0" encoding="utf-8"?>
<!-- SUBDESTRUCKT — Distribution de l'installateur (productbuild). Champs @...@ remplacés à la construction. -->
<installer-gui-script minSpecVersion="2">
  <title>SUBDESTRUCKT @BUILD_ID@ (build interne)</title>
  <organization>com.labtechno</organization>
  <welcome file="installer_welcome.html" mime-type="text/html"/>
  <conclusion file="installer_conclusion.html" mime-type="text/html"/>
  <options customize="never" require-scripts="true" hostArchitectures="arm64" rootVolumeOnly="true"/>
  <domains enable_localSystem="true" enable_currentUserHome="false" enable_anywhere="false"/>
  <volume-check>
    <allowed-os-versions>
      <os-version min="@MIN_MACOS@"/>
    </allowed-os-versions>
  </volume-check>
  <installation-check script="sbdInstallationCheck()"/>
  <script><![CDATA[
var SBD_PATH = '/Library/Audio/Plug-Ins/VST3/SUBDESTRUCKT.vst3';
var SBD_ID = 'com.labtechno.subdestruckt';
var SBD_VERSION = '@VERSION@';
var SBD_BUILD = '@BUILD@';
function sbdInstallationCheck() {
  if (system.sysctl('hw.optional.arm64') != 1) {
    my.result.title = 'Mac Apple Silicon requis';
    my.result.message = 'SUBDESTRUCKT est un plugin VST3 arm64 natif : il exige un Mac Apple Silicon. Rien n\'a été installé.';
    my.result.type = 'Fatal';
    return false;
  }
  if (system.compareVersions(system.version.ProductVersion, '@MIN_MACOS@') < 0) {
    my.result.title = 'Version de macOS non prise en charge';
    my.result.message = 'Cette build déclare macOS @MIN_MACOS@ au minimum (version déclarée, non encore validée). Rien n\'a été installé.';
    my.result.type = 'Fatal';
    return false;
  }
  if (system.files.fileExistsAtPath(SBD_PATH)) {
    var b = system.files.bundleAtPath(SBD_PATH);
    if (!b || b.CFBundleIdentifier != SBD_ID) {
      my.result.title = 'Élément non identifié';
      my.result.message = 'Un élément qui n\'est pas le plugin SUBDESTRUCKT occupe ' + SBD_PATH + '. Il ne sera pas remplacé. Rien n\'a été installé.';
      my.result.type = 'Fatal';
      return false;
    }
    var cmp = system.compareVersions(b.CFBundleShortVersionString, SBD_VERSION);
    if (cmp > 0 || (cmp == 0 && system.compareVersions(b.CFBundleVersion, SBD_BUILD) > 0)) {
      my.result.title = 'Retour à une version plus ancienne';
      my.result.message = 'Une version plus récente de SUBDESTRUCKT (' + b.CFBundleShortVersionString + ', build ' + b.CFBundleVersion + ') est installée. Les états et presets enregistrés par une version plus récente peuvent être refusés par celle-ci. Continuer remplace la version installée.';
      my.result.type = 'Warning';
      return false;
    }
  }
  return true;
}
]]></script>
  <choices-outline>
    <line choice="default"/>
  </choices-outline>
  <choice id="default" title="SUBDESTRUCKT VST3">
    <pkg-ref id="com.labtechno.subdestruckt.vst3"/>
  </choice>
  <pkg-ref id="com.labtechno.subdestruckt.vst3" version="@PKG_VERSION@" onConclusion="none">subdestruckt-vst3-component.pkg</pkg-ref>
</installer-gui-script>
